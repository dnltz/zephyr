/dts-v1/;

#include <ti/am64x_m4.dtsi>
#include "phyboard_electra_am6442_m4-pinctrl.dtsi"

/ {
	model = "PHYTEC phyBOARD-Electra AM64x M4";
	compatible = "phytec,phyboard-electra-am64xx-m4", "ti,am6442";

	chosen {
		zephyr,sram = &sram0;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,sram1 = &ddr0;
	};

	aliases {
		led0 = &heartbeat_led;
	};

	cpus {
		cpu@0 {
			status = "okay";
			clock-frequency = <DT_FREQ_M(400)>;
		};
	};

	ddr0:memory@a4100000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0xa4100000 DT_SIZE_K(4)>;
		zephyr,memory-region = "DDR";
	};

	leds: leds {
		compatible = "gpio-leds";
		heartbeat_led: led_0 {
			gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
			label = "Heartbeat LED";
		};
	};
};

&uart0 {
	current-speed = <115200>;
	pinctrl-0 = <&mcu_uart0_rx_default &mcu_uart0_tx_default>;
	pinctrl-names = "default";
	status = "okay";
};

&i2c0 {
	pinctrl-0 = <&mcu_i2c0_sda_default &mcu_i2c0_scl_default>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";

	tmp102@48 {
		compatible = "ti,tmp112";
		reg = <0x48>;
	};
};

&i2c1 {
	pinctrl-0 = <&mcu_i2c1_sda_default &mcu_i2c1_scl_default>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";

	veml6030@10 {
		compatible = "vishay,veml7700";
		reg = <0x10>;
	};
};


&gpio0 {
	pinctrl-0 = <&mcu_gpio0_led_default>;
	pinctrl-names = "default";
	status = "okay";
};
