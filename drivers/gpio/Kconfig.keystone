# TI Keystone GPIO configuration option

# Copyright (c) 2023 Daniel Schultz <d.schultz@phytec.de>
# SPDX-License-Identifier: Apache-2.0

config GPIO_KEYSTONE
	bool "TI Keystone GPIO driver"
	default y
	depends on SOC_AM62x_M4
	help
	  Enable driver for the TI Keystone GPIO controller.

	  Says n if not sure.
